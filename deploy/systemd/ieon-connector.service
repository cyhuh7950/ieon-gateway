# 이어온 연결부(사용자 유닛). 실제 엔진 실행 여부(live)는 .local/s2/connector.json 이 정한다. 유닛은 live를 바꾸지 않는다.
# 연결부는 Codex·Claude 기록이 있는 홈 폴더(~/.codex, ~/.claude)와 작업 폴더에 써야 하므로 ProtectHome·ProtectSystem을 걸지 않는다.
[Unit]
Description=이어온 연결부
After=ieon-server.service
Wants=ieon-server.service

[Service]
Type=simple
WorkingDirectory=%h/deploy/ieon-gateway
ExecStart=/usr/bin/env node src/pilot/connector.mjs .local/s2/connector.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
